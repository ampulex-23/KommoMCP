# Kommo API Configuration
KOMMO_SUBDOMAIN=your-subdomain
KOMMO_ACCESS_TOKEN=your-access-token

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kommo_mcp

# MCP Server
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Webhook Server (optional)
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8001
WEBHOOK_SECRET=your-webhook-secret

# LLM Provider (shared for all tenants)
LLM_BASE_URL=https://api.polza.ai/v1
LLM_API_KEY=your-polza-api-key

# Lead Generation APIs
DADATA_API_TOKEN=your-dadata-api-token
TWOGIS_API_KEY=your-2gis-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Sync settings
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_MINUTES=5
